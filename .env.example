# Web app environment — copy to apps/web/.env (scripts/setup.sh writes it for you).

# Supabase project URL and anon key — bundled into the browser (public).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Service-role key — server only, never prefix with VITE_.
# Used by Settings → Delete account and Settings → Members → Remove.
SUPABASE_SERVICE_ROLE_KEY=
